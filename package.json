{
  "name": "arthur-shakov-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio of Arthur Shakov — Terminal direction, static build from DESIGN-SPEC.md",
  "scripts": {
    "build": "node src/build.mjs",
    "watch": "chokidar \"src/**/*\" -c \"node src/build.mjs\" --initial",
    "serve": "live-server dist --port=5173 --no-browser --quiet",
    "dev": "concurrently -k -n build,serve -c blue,green \"npm:watch\" \"npm:serve\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "live-server": "^1.2.2",
    "sass": "^1.83.0",
    "sharp": "^0.33.5"
  }
}
